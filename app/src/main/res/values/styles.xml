<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FlickMix" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/fm_black</item>
        <item name="android:colorAccent">@color/fm_green</item>
        <item name="android:textColorPrimary">@color/fm_white</item>
        <item name="android:textColorSecondary">@color/fm_grey</item>
    </style>

    <style name="Theme.FlickMix.Player" parent="Theme.FlickMix">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- Heading face: Permanent Marker (Apache 2.0), the 90s hand-drawn
         marker look from the brand references. Headings, nav, buttons and
         labels only; body copy stays on a readable TV face on purpose. -->
    <style name="FmDisplay">
        <item name="android:fontFamily">@font/flickmix_display</item>
        <item name="android:textColor">@color/fm_white</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Body / metadata face: readable at 10 feet, never decorative. -->
    <style name="FmBody">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/fm_grey</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="FmButton">
        <item name="android:background">@drawable/btn_bg</item>
        <item name="android:textColor">@color/fm_white</item>
        <item name="android:fontFamily">@font/flickmix_display</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
