<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingEnd="36dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/shelfTitle"
                style="@style/FmDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_shelf" />

            <!-- Brand accent: the green underline stroke from the reference art -->
            <View
                android:layout_width="46dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:background="@color/fm_green" />
        </LinearLayout>

        <TextView
            android:id="@+id/shelfCount"
            style="@style/FmBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/fm_green"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/shelfViewAll"
            style="@style/FmBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/focus_bg"
            android:textColor="@color/fm_green"
            android:textSize="13sp"
            android:text="@string/view_all"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/shelfRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingEnd="36dp"
        android:descendantFocusability="afterDescendants" />
</LinearLayout>
