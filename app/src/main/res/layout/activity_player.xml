<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fm_black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:resize_mode="fit"
        app:surface_type="surface_view" />

    <ProgressBar
        android:id="@+id/buffering"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/fm_green"
        android:visibility="gone" />

    <!-- =================== CONTROL OVERLAY =================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top: back, title, source, meta chips -->
        <LinearLayout
            android:id="@+id/topRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/fm_scrim"
            android:paddingStart="@dimen/overscan_h"
            android:paddingEnd="@dimen/overscan_h"
            android:paddingTop="@dimen/overscan_v"
            android:paddingBottom="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/backBtn"
                style="@style/FmButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="\u2190"
                android:textSize="18sp"
                android:minWidth="52dp"
                android:layout_marginEnd="16dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/playerTitle"
                    style="@style/FmDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="24sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/playerMeta"
                    style="@style/FmBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_meta"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/sourceLabel"
                style="@style/FmBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/fm_green"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/favBtn"
                style="@style/FmButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="♡"
                android:textSize="20sp"
                android:minWidth="52dp"
                android:layout_marginStart="16dp" />
        </LinearLayout>

        <!-- Centre transport -->
        <LinearLayout
            android:id="@+id/centreRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/rewindBtn"
                style="@style/FmButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="\u21BA 10"
                android:textSize="18sp"
                android:minWidth="86dp"
                android:layout_marginEnd="20dp" />

            <TextView
                android:id="@+id/playBtn"
                style="@style/FmButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PAUSE"
                android:textSize="18sp"
                android:minWidth="120dp"
                android:minHeight="56dp" />

            <TextView
                android:id="@+id/forwardBtn"
                style="@style/FmButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10 \u21BB"
                android:textSize="18sp"
                android:minWidth="86dp"
                android:layout_marginStart="20dp" />
        </LinearLayout>

        <!-- Bottom: scrubber + option buttons -->
        <LinearLayout
            android:id="@+id/bottomBlock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/scrim_bottom"
            android:paddingStart="@dimen/overscan_h"
            android:paddingEnd="@dimen/overscan_h"
            android:paddingTop="24dp"
            android:paddingBottom="@dimen/overscan_v"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/timeCurrent"
                    style="@style/FmBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/fm_white"
                    android:minWidth="70dp"
                    android:text="0:00" />

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="1000"
                    android:focusable="true"
                    android:progressTint="@color/fm_green"
                    android:thumbTint="@color/fm_green"
                    android:progressBackgroundTint="@color/fm_grey_dim"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:id="@+id/timeTotal"
                    style="@style/FmBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/fm_white"
                    android:minWidth="70dp"
                    android:gravity="end"
                    android:text="0:00" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp">

                <TextView
                    android:id="@+id/subsBtn"
                    style="@style/FmButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SUBTITLES"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/audioBtn"
                    style="@style/FmButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AUDIO"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/qualityBtn"
                    style="@style/FmButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="QUALITY"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/speedBtn"
                    style="@style/FmButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SPEED"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/serverBtn"
                    style="@style/FmButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SOURCE"
                    android:layout_marginEnd="10dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/remoteHint"
                    style="@style/FmBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:textSize="12sp"
                    android:textColor="@color/fm_grey_dim"
                    android:text="OK play/pause   \u25C0 \u25B6 skip 10s   \u25B2 \u25BC controls   MENU quality   BACK exit" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
