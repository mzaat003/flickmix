<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/posterRoot"
    android:layout_width="@dimen/poster_w"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:focusable="true"
    android:background="@drawable/focus_bg"
    android:padding="4dp"
    android:layout_marginEnd="12dp">

    <ImageView
        android:id="@+id/posterImage"
        android:layout_width="match_parent"
        android:layout_height="@dimen/poster_h"
        android:scaleType="centerCrop"
        android:background="@drawable/poster_placeholder"
        android:contentDescription="@null" />

    <ProgressBar
        android:id="@+id/posterProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:progressTint="@color/fm_green"
        android:visibility="gone" />

    <TextView
        android:id="@+id/posterTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/fm_white"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/posterMeta"
        style="@style/FmBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_meta"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
