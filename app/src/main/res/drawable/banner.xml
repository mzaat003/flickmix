<?xml version="1.0" encoding="utf-8"?>
<!-- Fire TV launcher banner (320x180). Replace with a PNG at
     res/drawable-xhdpi/banner.png for the hand-drawn wordmark. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/fm_black" />
        </shape>
    </item>
    <item android:gravity="bottom" android:height="8dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/fm_green" />
        </shape>
    </item>
</layer-list>
