<?xml version="1.0" encoding="utf-8"?>
<!-- Every focusable control uses this. Focus is a bright green ring plus a
     lifted fill; unfocused is a flat card. Nothing relies on colour alone. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/fm_card" />
            <stroke android:width="@dimen/focus_stroke" android:color="@color/fm_green" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/fm_card" />
            <stroke android:width="1dp" android:color="@color/fm_green_dim" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/fm_card" />
            <stroke android:width="1dp" android:color="@color/fm_stroke" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
