<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF1F2B00" />
            <stroke android:width="2dp" android:color="@color/fm_green" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF16200A" />
            <stroke android:width="2dp" android:color="@color/fm_green_dim" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF101010" />
            <stroke android:width="1dp" android:color="@color/fm_stroke" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>
